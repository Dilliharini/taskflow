# Application Configuration
PROJECT_NAME="TaskFlow API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (JSON array or comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="taskflow"
POSTGRES_PASSWORD="taskflow_secret"
POSTGRES_DB="taskflow"

# Database URL (SQLAlchemy 2.x with psycopg 3)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://taskflow:taskflow_secret@localhost:5432/taskflow"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security (development placeholder only; use a unique random 32+ character secret in production)
JWT_SECRET_KEY="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
